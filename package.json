{
  "name": "teslawave",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @teslawave/web dev",
    "dev:worker": "pnpm --filter @teslawave/worker dev",
    "build": "pnpm --filter @teslawave/web build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @teslawave/web test:e2e",
    "sim": "pnpm --filter @teslawave/worker sim",
    "usage": "node scripts/usage-report.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:css": "node scripts/check-css.mjs",
    "deploy": "pnpm build && pnpm --filter @teslawave/worker deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "@cloudflare/workerd-linux-64",
      "sharp",
      "@parcel/watcher",
      "unrs-resolver"
    ]
  }
}
